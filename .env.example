# Process environment template; the app does not automatically load this file.
APP_MODE=local
GOOGLE_CLOUD_PROJECT=demo-aml-insight
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
OPERATOR_UIDS=operator-demo
ADMIN_UIDS=operator-demo
LIVE_AI_ENABLED=false
CREDITS_VERIFIED=false
LOCAL_GEMINI_ENABLED=false
LOCAL_GEMINI_FREE_VERIFIED=false
CLOUD_TASKS_ENABLED=false
OPERATOR_DEMO_LOGIN_ENABLED=false
# Cloud deployment supplies project, Firebase public configuration, identities,
# verified model/location, credit expiry and task delivery settings externally.
# Never commit a model key, login secret, token or service-account credential.
