{
  "name": "aml-insight-genesis",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-led AML investigation workspace",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "api": "node scripts/python.cjs -m uvicorn backend.api:app --host 127.0.0.1 --port 8080",
    "seed": "node scripts/python.cjs -m backend.seed",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-aml-insight",
    "bulk:generate": "node scripts/python.cjs -m backend.bulk_dataset",
    "bulk:import": "node scripts/python.cjs -m backend.bulk_jobs --import-local"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
